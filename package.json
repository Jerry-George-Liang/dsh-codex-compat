{
  "name": "@local/dsh-codex-compat",
  "version": "1.1.4",
  "private": false,
  "author": "Jerry-George-Liang",
  "homepage": "https://github.com/Jerry-George-Liang/dsh-codex-compat#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Jerry-George-Liang/dsh-codex-compat.git" },
  "keywords": ["dsh-plugin", "deepseek-harness", "codex", "openai-responses", "proxy"],
  "type": "module",
  "description": "Switch between scoped Codex headers and a managed loopback proxy with automatic provider routing.",
  "exports": { ".": "./host-1.1.4.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["host-1.1.4.js", "build.mjs", "index.js", "compat.js", "controller.js", "task-scope.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "test/*.test.js"],
  "dependencies": { "@deepseek-ai/schemastery": "3.19.0" },
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "scripts": { "build": "node build.mjs", "pretest": "node build.mjs", "test": "node --test --test-timeout=10000 test/*.test.js", "prepack": "node build.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-locale"] }
  }
}
